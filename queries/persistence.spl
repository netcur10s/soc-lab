# Persistence Detection Queries
# MITRE ATT&CK: T1053.005 - Scheduled Task/Job: Scheduled Task
# Detection Event: Windows Security EventCode 4698 (Scheduled Task Created)
# Lab tested: May 20, 2026 via ART T1053.005-2 (task name: "spawn")
# Prerequisite: "Audit Other Object Access Events" must be enabled via GPO
# GPO Path: Computer Configuration > Policies > Windows Settings > Security Settings >
#           Advanced Audit Policy Configuration > Object Access >
#           Audit Other Object Access Events (Success and Failure)

# ─────────────────────────────────────────────
# SCHEDULED TASK CREATION
# EventCode 4698 fires when any scheduled task is created
# Attackers use scheduled tasks for persistent code execution
# ─────────────────────────────────────────────
index=windows EventCode=4698
| table _time, host, Account_Name, Task_Name
| sort -_time


# ─────────────────────────────────────────────
# NEW SERVICE INSTALLATION
# EventCode 7045 = new service installed on the system
# Services are an alternate persistence mechanism alongside scheduled tasks
# Watch for unusual service names or paths
# ─────────────────────────────────────────────
index=windows EventCode=7045
| table _time, host, Service_Name, Service_File_Name, Service_Account
| sort -_time


# ─────────────────────────────────────────────
# POWERSHELL EXECUTION DETECTION (PROCESS CREATION)
# EventCode 4688 = process created (requires audit policy)
# Catch PowerShell or cmd.exe being launched as child processes
# ─────────────────────────────────────────────
index=windows EventCode=4688 (New_Process_Name=*powershell* OR New_Process_Name=*cmd*)
| table _time, host, Creator_Process_Name, New_Process_Name, Process_Command_Line


# ─────────────────────────────────────────────
# POWERSHELL EVASION FLAGS (SYSMON)
# Watch for common obfuscation and bypass flags in PowerShell CommandLine
#   -enc = base64 encoded command (hides content)
#   -nop = no profile (faster, stealthier launch)
#   bypass = explicit execution policy bypass
#   IEX = Invoke-Expression (downloads and runs code)
# ─────────────────────────────────────────────
index=windows EventCode=1 Image=*powershell*
| search CommandLine=*-enc* OR CommandLine=*-nop* OR CommandLine=*bypass* OR CommandLine=*IEX*
| table _time, host, ParentImage, CommandLine
