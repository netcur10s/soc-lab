# Foundational SPL Queries
# Purpose: First-look and baseline queries for any investigation
# Lab: Cyber Detection Home Lab | index=windows

# ─────────────────────────────────────────────
# ALL EVENTS - FIRST LOOK
# Use this to get oriented when you first open Splunk
# ─────────────────────────────────────────────
index=* | head 50


# ─────────────────────────────────────────────
# ALL HOSTS LOGGING TO SPLUNK
# Verify all forwarders are sending data
# ─────────────────────────────────────────────
index=windows
| stats count by host
| sort -count


# ─────────────────────────────────────────────
# VERIFY FORWARDER CONNECTIONS
# Check last seen time per hostname from internal metrics
# ─────────────────────────────────────────────
index=_internal source=*metrics.log group=tcpin_connections
| stats latest(_time) as last_seen by hostname


# ─────────────────────────────────────────────
# ALL LOGONS BY HOST AND TYPE
# Baseline - understand what normal logon patterns look like
# Logon_Type 2=Interactive, 3=Network, 10=RemoteInteractive
# ─────────────────────────────────────────────
index=windows EventCode=4624
| stats count by host, Account_Name, Logon_Type
| sort -count


# ─────────────────────────────────────────────
# FAILED LOGONS SUMMARY
# Quick view of failed auth attempts across environment
# ─────────────────────────────────────────────
index=windows EventCode=4625
| stats count by host, Account_Name, Source_Network_Address
| sort -count


# ─────────────────────────────────────────────
# PROCESSES CREATED (SYSMON)
# Primary hunting event for execution detection
# Requires Sysmon EventCode=1
# ─────────────────────────────────────────────
index=windows source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
| table _time, host, Image, ParentImage, CommandLine


# ─────────────────────────────────────────────
# NEW SCHEDULED TASKS
# Quick view of any scheduled task creation events
# ─────────────────────────────────────────────
index=windows EventCode=4698
| table _time, host, Account_Name, Task_Name


# ─────────────────────────────────────────────
# NEW LOCAL ACCOUNTS (CLEAN FIELDS)
# Uses mvindex to split subject vs target from Account_Name multivalue field
# ─────────────────────────────────────────────
index=windows EventCode=4720
| eval Who_Created=mvindex(Account_Name,0)
| eval Account_Created=mvindex(Account_Name,1)
| table _time, host, Who_Created, Account_Created


# ─────────────────────────────────────────────
# EVENTS FROM LAST 2 MINUTES
# Real-time view after running an attack simulation
# ─────────────────────────────────────────────
index=windows
| where _time >= relative_time(now(),"-2m")
| stats count by host, EventCode
| sort host
