# Lateral Movement Detection Queries
# MITRE ATT&CK: T1021.002 - Remote Services: SMB/Windows Admin Shares
# Detection Event: Windows Security EventCode 4624 (Successful Logon) Logon_Type=3
# Lab tested: May 19, 2026 via ART T1021.002

# ─────────────────────────────────────────────
# LATERAL MOVEMENT - NETWORK LOGONS
# Logon_Type=3 means authentication happened over the network (SMB, shares)
# An account logging into multiple machines via network is a lateral movement signal
# ─────────────────────────────────────────────
index=windows EventCode=4624 Logon_Type=3
| eval user=mvindex(Account_Name,1)
| table _time, host, user, Logon_Type, Source_Network_Address
| sort -_time


# ─────────────────────────────────────────────
# LATERAL MOVEMENT INDICATOR - MACHINES ACCESSED
# An account that authenticates to more than one machine
# in a session is a strong lateral movement indicator
# dc(host) counts distinct machines accessed by each account
# ─────────────────────────────────────────────
index=windows EventCode=4624
| stats dc(host) as machines_accessed, values(host) as hosts by Account_Name
| where machines_accessed > 1
| sort -machines_accessed


# ─────────────────────────────────────────────
# AD ENUMERATION DETECTION (BLOODHOUND/SHARPHOUND)
# BloodHound generates mass Logon_Type=3 events on the DC
# because it queries LDAP to map all domain objects and paths
# More than 10 network logons from one account in 10 minutes to DC is a signal
# ─────────────────────────────────────────────
index=windows host=DC-01 EventCode=4624 Logon_Type=3
| where _time >= relative_time(now(),"-10m")
| stats count by Account_Name, Workstation_Name
| sort -count
| where count > 10


# ─────────────────────────────────────────────
# EXPLICIT CREDENTIAL USAGE
# EventCode 4648 = logon attempted using explicit credentials
# This is unusual for human interactive sessions - typically seen with
# scripts, scheduled tasks, or pass-the-hash / lateral movement tools
# ─────────────────────────────────────────────
index=windows EventCode=4648
| eval user=mvindex(Account_Name,0)
| table _time, host, user, Target_Server_Name, Target_User_Name
| sort -_time
