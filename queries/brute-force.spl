# Brute Force Detection Queries
# MITRE ATT&CK: T1110.001 - Brute Force: Password Guessing
# Detection Event: Windows Security EventCode 4625 (Failed Logon)
# Lab tested: May 19, 2026 via ART T1110.001

# ─────────────────────────────────────────────
# BRUTE FORCE DETECTION - 5+ FAILURES IN 60 SECONDS
# Buckets events into 60-second windows and flags accounts
# with 5 or more failures in the same window
# ─────────────────────────────────────────────
index=windows EventCode=4625
| eval user=mvindex(Account_Name,1)
| bucket _time span=60s
| stats count by _time, user, Source_Network_Address, host
| where count >= 5
| sort -count


# ─────────────────────────────────────────────
# BRUTE FORCE SUB_STATUS ANALYSIS
# Sub_Status tells you what the attacker is actually doing:
#   0xC0000064 = Username does not exist (username enumeration)
#   0xC000006A = Wrong password (password guessing against valid account)
# Knowing which sub-status you see tells you whether to focus on
# account enumeration or credential spraying
# ─────────────────────────────────────────────
index=windows EventCode=4625
| eval user=mvindex(Account_Name,1)
| table _time, user, Source_Network_Address, Sub_Status
| sort -_time


# ─────────────────────────────────────────────
# FAILED LOGON VOLUME OVER TIME
# Useful for visualizing a brute force spike in a timechart
# ─────────────────────────────────────────────
index=windows EventCode=4625
| eval user=mvindex(Account_Name,1)
| timechart span=5m count by user
