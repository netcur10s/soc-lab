# Account Lifecycle and Backdoor Detection Queries
# MITRE ATT&CK: T1136.001 - Create Account: Local Account
# Detection Events: 4720 (account created), 4726 (account deleted), 4732 (added to group)
# Lab tested: May 16-19, 2026

# ─────────────────────────────────────────────
# ACCOUNT CREATION - CLEAN FIELD EXTRACTION
# Account_Name is a multivalue field in Windows events:
#   mvindex(Account_Name,0) = who performed the action (actor)
#   mvindex(Account_Name,1) = the target account (subject)
# ─────────────────────────────────────────────
index=windows EventCode=4720
| eval Who_Created=mvindex(Account_Name,0)
| eval Account_Created=mvindex(Account_Name,1)
| table _time, host, Who_Created, Account_Created


# ─────────────────────────────────────────────
# ACCOUNT DELETION
# Pair with 4720 to see full lifecycle
# Rapid create + delete sequence is a red flag - attacker used and cleaned up
# ─────────────────────────────────────────────
index=windows EventCode=4726
| eval Who_Deleted=mvindex(Account_Name,0)
| eval Account_Deleted=mvindex(Account_Name,1)
| table _time, host, Who_Deleted, Account_Deleted


# ─────────────────────────────────────────────
# BACKDOOR ACCOUNT + PRIVILEGE ESCALATION (CORRELATED)
# Correlates account creation (4720) with group membership change (4732)
# in the same query - shows both events side by side
# Note: Member_Name in 4732 events can be blank if SID not resolved.
# Use SAM_Account_Name from the 4720 event instead for the account name.
# coalesce(Computer, host) handles field name differences between DC and workstation events
# ─────────────────────────────────────────────
index=windows (EventCode=4720 OR EventCode=4732)
| eval Computer=coalesce(Computer, host)
| eval EventType=case(EventCode=4720, "Account Created", EventCode=4732, "Added to Administrators")
| table _time, Computer, EventCode, EventType, Account_Name, SAM_Account_Name
| sort _time


# ─────────────────────────────────────────────
# MEMBER ADDED TO LOCAL ADMINISTRATORS GROUP
# Standalone query for privilege escalation monitoring
# EventCode 4732 = member added to local security-enabled group
# ─────────────────────────────────────────────
index=windows EventCode=4732
| eval Actor=mvindex(Account_Name,0)
| table _time, host, Actor, SAM_Account_Name, Group_Name
| sort -_time
