# Kerberoasting Detection Queries
# MITRE ATT&CK: T1558.003 - Steal or Forge Kerberos Tickets: Kerberoasting
# Detection Event: Windows Security EventCode 4769 (Kerberos Service Ticket Requested)
# Lab tested: May 19, 2026 via ART T1558.003 -TestNumbers 5
# Lab setup: svc_sql service account with SPN MSSQLSvc/DC01.lab.local:1433, RC4 forced

# ─────────────────────────────────────────────
# KERBEROASTING DETECTION - RC4 TICKETS
# The key indicator is Ticket_Encryption_Type=0x17
# 0x17 = RC4 encryption, which is weak and specifically requested by attack tools
# because RC4 hashes are faster to crack offline than AES
# AES (0x12 or 0x18) is what legitimate modern systems use
# ─────────────────────────────────────────────
index=windows EventCode=4769 Ticket_Encryption_Type=0x17
| table _time, host, Account_Name, Service_Name, Ticket_Encryption_Type
| sort -_time


# ─────────────────────────────────────────────
# KERBEROASTING - VOLUME ANALYSIS
# Multiple RC4 ticket requests from one account in a short window
# is a stronger signal than a single request
# ─────────────────────────────────────────────
index=windows EventCode=4769 Ticket_Encryption_Type=0x17
| eval user=mvindex(Account_Name,0)
| bucket _time span=60s
| stats count by _time, user, host
| where count > 3
| sort -count


# ─────────────────────────────────────────────
# KERBEROS TICKET ENCRYPTION COMPARISON
# Baseline all encryption types to understand what is normal
# vs what is suspicious in your environment
# ─────────────────────────────────────────────
index=windows EventCode=4769
| stats count by Ticket_Encryption_Type, Account_Name
| sort -count


# ─────────────────────────────────────────────
# KERBEROS TGT REQUESTS - BASELINE
# EventCode 4768 = TGT requested (initial auth)
# Look for unusual accounts or off-hours requests
# ─────────────────────────────────────────────
index=windows EventCode=4768
| table _time, host, Account_Name, Client_Address
| sort -_time
